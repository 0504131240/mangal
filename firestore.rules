rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules, with __OWNER_EMAILS__ replaced by the
// owners' Google emails in quotes, e.g. 'a@gmail.com', 'b@gmail.com' (kept out of this public repo).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // owners always have access, and only they can change the list of added admins
    function isOwner() {
      return signedInEmail() && request.auth.token.email.lower() in [__OWNER_EMAILS__];
    }
    function adminsPath() {
      return /databases/$(database)/documents/mangalSettings/admins;
    }
    function isAdmin() {
      return isOwner() || (signedInEmail() && exists(adminsPath())
        && request.auth.token.email.lower() in get(adminsPath()).data.emails);
    }
    function optionalText(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function validRequest(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'date', 'washTime', 'guests', 'men', 'women', 'level',
                               'location', 'notes', 'status', 'totalPrice', 'paidAmount', 'createdAt', 'createdAtMs'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        && optionalText(d.email, 200)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.guests is int && d.guests > 0 && d.guests <= 5000
        && (!('washTime' in d) || (d.washTime is string && d.washTime.matches('^[0-9]{2}:[0-9]{2}$')))
        && ((!('men' in d) && !('women' in d))
            || (d.men is int && d.women is int && d.men >= 0 && d.women >= 0 && d.men + d.women == d.guests))
        && d.level in ['CLASIC', 'SPECIAL', 'CRAZY']
        && optionalText(d.location, 300)
        && optionalText(d.notes, 2000)
        && d.status == 'pending' && d.totalPrice == 0 && d.paidAmount == 0
        && d.createdAt == request.time
        && d.createdAtMs is int;
    }
    // the notification server may read a request, and mark it notified, only right after it was sent
    function justSubmitted() {
      return 'createdAt' in resource.data && request.time < resource.data.createdAt + duration.value(15, 'm');
    }

    match /mangalBookings/{id} {
      allow create: if isAdmin() || validRequest(request.resource.data);
      allow get: if isAdmin() || justSubmitted();
      allow list, delete: if isAdmin();
      allow update: if isAdmin() || (
        justSubmitted()
        && !('notifiedAtMs' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifiedAtMs'])
        && request.resource.data.notifiedAtMs is int
      );
    }

    // public: the gallery shown on the site, and push subscriptions
    // (a subscription can only receive pushes signed with the server's private VAPID key)
    match /mangalSettings/{doc} {
      allow read: if doc in ['gallery', 'push'] || isAdmin();
      allow write: if isAdmin() && doc != 'admins';
    }
    match /mangalSettings/admins {
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['emails'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 50;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
