rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules, with __OWNER_EMAILS__ replaced by the
// owners' Google emails in quotes, e.g. 'a@gmail.com', 'b@gmail.com' (kept out of this public repo).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // owners always have access, and only they can change the list of added admins
    function isOwner() {
      return signedInEmail() && request.auth.token.email.lower() in [__OWNER_EMAILS__];
    }
    function adminsPath() {
      return /databases/$(database)/documents/mangalSettings/admins;
    }
    function isAdmin() {
      return isOwner() || (signedInEmail() && exists(adminsPath())
        && request.auth.token.email.lower() in get(adminsPath()).data.emails);
    }
    function optionalText(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function validRequest(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'date', 'washTime', 'guests', 'men', 'women', 'level',
                               'massage', 'location', 'notes', 'status', 'totalPrice', 'paidAmount', 'createdAt', 'createdAtMs'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        && optionalText(d.email, 200)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.guests is int && d.guests > 0 && d.guests <= 5000
        && (!('washTime' in d) || (d.washTime is string && d.washTime.matches('^[0-9]{2}:[0-9]{2}$')))
        && ((!('men' in d) && !('women' in d))
            || (d.men is int && d.women is int && d.men >= 0 && d.women >= 0 && d.men + d.women == d.guests))
        && d.level in ['CLASIC', 'SPECIAL', 'CRAZY']
        && (!('massage' in d) || d.massage is bool)
        && optionalText(d.location, 300)
        && optionalText(d.notes, 2000)
        && d.status == 'pending' && d.totalPrice == 0 && d.paidAmount == 0
        && d.createdAt == request.time
        && d.createdAtMs is int;
    }
    // the notification server may read a request, and mark it notified, only right after it was sent
    function justSubmitted() {
      return 'createdAt' in resource.data && request.time < resource.data.createdAt + duration.value(15, 'm');
    }

    match /mangalBookings/{id} {
      allow create: if isAdmin() || validRequest(request.resource.data);
      allow get: if isAdmin() || justSubmitted();
      allow list, delete: if isAdmin();
      allow update: if isAdmin() || (
        justSubmitted()
        && !('notifiedAtMs' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifiedAtMs'])
        && request.resource.data.notifiedAtMs is int
      );
    }

    // a review a customer sent from the site: waits here until an admin approves it (then it's copied into
    // mangalSettings/gallery's reviews and deleted here) or deletes it
    function validReview(d) {
      return d.keys().hasOnly(['text', 'name', 'event', 'createdAt', 'createdAtMs'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 600
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && optionalText(d.event, 40)
        && d.createdAt == request.time
        && d.createdAtMs is int;
    }
    match /mangalReviewRequests/{id} {
      allow create: if validReview(request.resource.data);
      allow get: if isAdmin() || justSubmitted();
      allow list, delete: if isAdmin();
      allow update: if justSubmitted()
        && !('notifiedAtMs' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifiedAtMs'])
        && request.resource.data.notifiedAtMs is int;
    }

    // public: the gallery shown on the site, push subscriptions (a subscription can only receive pushes
    // signed with the server's private VAPID key), and the upcoming events' dates for the day-before
    // reminder (date, time, size and level only, no names or phones)
    match /mangalSettings/{doc} {
      allow read: if doc in ['gallery', 'push', 'reminders'] || isAdmin();
      allow write: if isAdmin() && doc != 'admins';
    }
    match /mangalSettings/admins {
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['emails'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 50;
    }

    // visit counter: one document per day (Israel date), the site adds 1 view per page load, 1 visitor
    // the first time a browser opens it that day and 1 device the first time a browser ever opens it;
    // only admins can read the numbers
    function validStats(d) {
      return d.keys().hasOnly(['views', 'visitors', 'devices'])
        && d.views is int && d.visitors is int && d.devices is int;
    }
    match /mangalStats/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validStats(request.resource.data)
        && request.resource.data.views == 1
        && request.resource.data.visitors in [0, 1]
        && request.resource.data.devices in [0, 1];
      allow update: if validStats(request.resource.data)
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.visitors - resource.data.visitors in [0, 1]
        && request.resource.data.devices - resource.data.devices in [0, 1];
    }

    // what visitors did and where they came from, as counts per day (mangalVisitInfo/{Israel date}): written by
    // index.html (act_*) and api/visit.js (src_*, dev_*, area_*); each write adds 1 to at most 3 known counters
    function visitKeys() {
      return [
        'src_direct', 'src_wa', 'src_ig', 'src_fb', 'src_search', 'src_tiktok', 'src_other',
        'dev_mobile', 'dev_tablet', 'dev_desktop', 'area_jm', 'area_ta', 'area_ha', 'area_m',
        'area_z', 'area_d', 'area_ys', 'area_abroad', 'area_unknown', 'act_menus', 'act_gallery',
        'act_reviews', 'act_massage', 'act_book', 'act_bookStart', 'act_bookSent', 'act_wa',
        'act_call', 'act_contact'
      ];
    }
    function prevCount(k) {
      return resource == null ? 0 : resource.data.get(k, 0);
    }
    function bumped(k) {
      return !(k in request.resource.data) || (request.resource.data[k] is int
        && (request.resource.data[k] == prevCount(k) || request.resource.data[k] == prevCount(k) + 1));
    }
    match /mangalVisitInfo/{day} {
      allow read: if isAdmin();
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(visitKeys())
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().size() <= 3
        && bumped('src_direct') && bumped('src_wa') && bumped('src_ig') && bumped('src_fb') &&
        bumped('src_search') && bumped('src_tiktok') && bumped('src_other') && bumped('dev_mobile') &&
        bumped('dev_tablet') && bumped('dev_desktop') && bumped('area_jm') && bumped('area_ta') &&
        bumped('area_ha') && bumped('area_m') && bumped('area_z') && bumped('area_d') && bumped('area_ys') &&
        bumped('area_abroad') && bumped('area_unknown') && bumped('act_menus') && bumped('act_gallery') &&
        bumped('act_reviews') && bumped('act_massage') && bumped('act_book') && bumped('act_bookStart') &&
        bumped('act_bookSent') && bumped('act_wa') && bumped('act_call') && bumped('act_contact');
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
